{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "duplex_*": "deny",
    "*": "allow"
  },
  "mcp": {
    "duplex": {
      "type": "local",
      "command": ["node", "C:\\path\\to\\Duplex\\dist-bridge\\index.cjs"],
      "cwd": "C:\\path\\to\\Duplex",
      "enabled": true,
      "timeout": 20000
    }
  }
}
