{
  "name": "duplex",
  "version": "0.3.0-beta.2",
  "private": true,
  "description": "Duplex - one browser shared by a human and an AI: visual for the human, source-level for the AI",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:canvas": "vite --config vite.canvas.config.ts",
    "build": "electron-vite build && vite build --config vite.canvas.config.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:bridge": "esbuild src/mcp-bridge/index.ts --bundle --platform=node --format=cjs --outfile=dist-bridge/index.cjs --external:electron --banner:js=\"#!/usr/bin/env node\"",
    "bridge": "node dist-bridge/index.cjs",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "predist": "npm run build:bridge && npm run build",
    "predist:mac": "npm run build:bridge && npm run build",
    "predist:linux": "npm run build:bridge && npm run build",
    "dist": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "electron-updater": "^6.8.11",
    "playwright-core": "^1.64.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.duplex.app",
    "productName": "Duplex",
    "directories": {
      "output": "release"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "out/**/*",
      "package.json",
      "dist-bridge/**/*"
    ],
    "asarUnpack": [
      "dist-bridge/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Duplex"
    }
  }
}
